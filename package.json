{
  "name": "localcord",
  "productName": "LocalCord",
  "version": "2.1.1",
  "description": "Голос, чат и демонстрация экрана для локальной сети и Radmin VPN — Windows и Android",
  "author": "Zubakamaraka",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "server": "node src/server/standalone.js",
    "test": "node test/server.test.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --win dir --publish never",
    "test:e2e": "node test/e2e.js",
    "android:sync": "cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "socket.io-client": "^4.8.4"
  },
  "build": {
    "appId": "com.localcord.app",
    "productName": "LocalCord",
    "copyright": "© 2026 Zubakamaraka",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "LocalCord"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LocalCord",
      "uninstallDisplayName": "LocalCord",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "LocalCord-Setup-${version}.${ext}"
    },
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "compression": "maximum",
    "publish": null
  }
}
